# Class Call Agent — Environment Configuration

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Call Provider: "desktop" (development) or "telephony" (future)
CALL_PROVIDER=desktop

# Database
DATABASE_URL=sqlite:///./data/caller_agent.db

# Scheduler
DAILY_SCHEDULE_HOUR=17
DAILY_SCHEDULE_MINUTE=0
RETRY_CHECK_INTERVAL_SECONDS=60

# Retry Logic
MAX_RETRIES=3
RETRY_DELAY_MINUTES=10

# Call Settings
CALL_TIMEOUT_SECONDS=120
SPEECH_LISTEN_TIMEOUT_SECONDS=15

# Text-to-Speech (edge-tts)
TTS_VOICE=en-IN-NeerjaNeural

# Excel
EXCEL_FILE_PATH=data/lecture_schedule.xlsx

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# Environment
ENVIRONMENT=development
DEBUG=false
